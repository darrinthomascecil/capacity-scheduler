# Copy to .env and fill in.  .env is gitignored; .env.example is not.
#   cp .env.example .env

# ---------------------------------------------------------------- required --

# Where profiles are stored. Azure Table Storage is the only durable backend.
# There is deliberately no default: a store that silently fell back to something
# local is how "profiles survive restarts" gets violated without anyone noticing.
#   memory://  exists for tests only and loses everything on exit.
AKSPROFILE_STORE=table://your-storage-account

# ---------------------------------------------------------------- guardrails --

# Absolute per-pool node limits, authored by a person. Every computed value is
# clamped into these before any scaling call, so a misread sentence can only
# produce a valid node count. Mount this read-only in a container.
AKSPROFILE_BOUNDS=/etc/aksprofile/targets.json

# ---------------------------------------------------------------- worker ----

# Seconds between evaluations. Sets how precisely a window boundary is hit.
AKSPROFILE_TICK_SECONDS=60

# true = compute and log, change nothing. Start here on a new deployment.
AKSPROFILE_DRY_RUN=true

# Touched after every successful tick; the container healthcheck reads its age.
AKSPROFILE_HEARTBEAT=/tmp/aksprofile.heartbeat

# ------------------------------------------------- language interpretation --
# Used ONLY by `aksprofile create`, once, when a profile is written.
# The worker never reads these -- it cannot reach the interpreter at all.

AKSPROFILE_MODEL=gpt-5.4-mini

# Point this at an Azure AI endpoint and NO API KEY IS NEEDED -- the app gets an
# AAD token from your Azure identity (`az login` locally, managed identity when
# deployed). Traffic stays in your subscription and there is nothing to rotate.
AKSPROFILE_BASE_URL=https://<your-ai-resource>.cognitiveservices.azure.com/openai/v1

# Only for a non-Azure endpoint such as api.openai.com. In a container, pass the
# key as a secret rather than in .env -- environment variables surface in crash
# dumps and orchestrator descriptions.
AKSPROFILE_API_KEY_VAR=OPENAI_API_KEY
OPENAI_API_KEY=

# ---------------------------------------------------------------- azure -----
# Auth is DefaultAzureCredential: a managed identity when deployed, `az login`
# locally. Set these only when using a service principal instead.
# AZURE_CLIENT_ID=
# AZURE_TENANT_ID=
# AZURE_CLIENT_SECRET=
