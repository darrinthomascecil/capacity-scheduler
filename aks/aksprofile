#!/usr/bin/env bash
HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PY="$HERE/.venv/bin/python"; [ -x "$PY" ] || PY="$HERE/../.venv/bin/python"
[ -x "$PY" ] || PY="$(command -v python3)"
PYTHONPATH="$HERE/src${PYTHONPATH:+:$PYTHONPATH}" exec "$PY" -c 'import sys; from aksprofile.cli import main; sys.exit(main())' "$@"
