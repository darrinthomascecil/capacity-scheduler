# Copy to .env and fill in.  .env is gitignored; .env.example is not.

# ---------------------------------------------------------------- required --
# Azure Table Storage. No default -- a store that silently fell back to local
# disk is how "profiles survive restarts" gets violated without anyone noticing.
APIMPROFILE_STORE=table://your-storage-account

# ---------------------------------------------------------------- guardrails --
# Absolute per-instance unit limits, authored by a person. The TIER maximum is
# applied on top of these and cannot be exceeded by anything set here.
APIMPROFILE_BOUNDS=/etc/apimprofile/targets.json

# ---------------------------------------------------------------- worker ----
# 5 minutes. A faster tick buys nothing: an APIM scale takes 15-45 minutes, so
# boundary precision finer than that is meaningless (DESIGN.md 3.3).
APIMPROFILE_TICK_SECONDS=300

# true = compute and log, change nothing. Start here on a new deployment.
APIMPROFILE_DRY_RUN=true

APIMPROFILE_HEARTBEAT=/tmp/apimprofile.heartbeat

# ------------------------------------------------- language interpretation --
# Used ONLY by `apimprofile create`. The worker never reads these and cannot
# reach the interpreter at all.
APIMPROFILE_MODEL=gpt-5.4-mini

# Point this at an Azure AI endpoint and NO API KEY IS NEEDED -- the app gets an
# AAD token from your Azure identity. Traffic stays in your subscription.
APIMPROFILE_BASE_URL=https://<your-ai-resource>.cognitiveservices.azure.com/openai/v1

# Only for a non-Azure endpoint. In a container, pass this as a secret.
APIMPROFILE_API_KEY_VAR=OPENAI_API_KEY
OPENAI_API_KEY=
